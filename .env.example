# Copie para .env.local e preencha. NUNCA faça commit de valores reais.

# Segredo para assinar o JWT de sessão (obrigatório a partir da Fase 3).
JWT_SECRET=

# Opcionais: sem chave, os textos usam o modo FALLBACK (templates).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Opcional: monitoramento de erros.
SENTRY_DSN=

# Opcional: origens extras com permissão de CORS (separadas por vírgula).
# Por padrão, só o próprio domínio do app (Vercel) e o localhost em desenvolvimento.
ALLOWED_ORIGINS=
