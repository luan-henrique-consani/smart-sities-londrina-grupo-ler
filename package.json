{
  "name": "londrina-limpa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,blue \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev",
    "dev:api": "node scripts/py.mjs -m uvicorn backend.main:app --reload --reload-dir backend --reload-dir api --port 8000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/py.mjs -m ruff check .",
    "test": "node scripts/py.mjs -m pytest -q",
    "data": "node scripts/py.mjs scripts/generate_data.py"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
