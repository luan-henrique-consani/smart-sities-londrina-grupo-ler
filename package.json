{
  "name": "prevora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,blue \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev",
    "dev:api": "node scripts/py.mjs -m uvicorn backend.main:app --reload --reload-dir backend --reload-dir api --port 8000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/py.mjs -m ruff check .",
    "test": "node scripts/py.mjs -m pytest -q",
    "data": "node scripts/py.mjs scripts/generate_data.py",
    "test:ui": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:ui && npm run test:e2e",
    "test:cov": "node scripts/py.mjs -m pytest -q --cov=backend --cov-report=term-missing"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
